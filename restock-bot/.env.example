# ===== Discord（海外向け・配信専用サーバー） =====
# Webhook URL はチャンネルの設定 →「連携サービス」→「ウェブフック」で作成します

# 有料会員だけが見られるチャンネル（ジャンル別）
# DISCORD_WEBHOOK_<ジャンル名> の形で書けば、監視設定の category と同じ名前のジャンルが増やせます
DISCORD_WEBHOOK_SOCCER=
DISCORD_WEBHOOK_ANIME=
DISCORD_WEBHOOK_IDOL=
# ジャンル別を作らない場合は、ここに1つだけ設定すれば全ジャンルがここに届きます
DISCORD_WEBHOOK_GLOBAL=

# 誰でも見られる無料チャンネル。有料チャンネルより遅れて同じ通知が届きます（宣伝用）
DISCORD_WEBHOOK_FREE=
# 無料チャンネルへの遅延（分）
FREE_DELAY_MIN=30
# 無料チャンネルの通知に載せる、有料会員の申し込みページ（Whop など）
JOIN_URL=

# 自分だけが見られる管理用チャンネル。監視の失敗が続いたときに知らせます
DISCORD_WEBHOOK_STATUS=
# 何回続けて失敗したら知らせるか
FAILURE_THRESHOLD=3

# ===== リンクと表示 =====
# 購入代行サービスのURLテンプレート。{url} が商品URLに置き換わります
# 例: PROXY_URL_TEMPLATE=https://example-proxy.com/shop?url={url}
PROXY_URL_TEMPLATE=
# ドル換算の目安を併記する場合のレート（例: 150）。空なら円のみ
JPY_PER_USD=

# ===== 監視 =====
# 監視の間隔（秒）
POLL_INTERVAL_SEC=300

# 楽天ウェブサービス（https://webservice.rakuten.co.jp/）で取得。楽天を監視する場合のみ
RAKUTEN_APPLICATION_ID=
# RAKUTEN_ENDPOINT=https://app.rakuten.co.jp/services/api/IchibaItem/Search/20220601

# ===== 日本向け（現在は休止中。使う場合のみ） =====
# RAKUTEN_AFFILIATE_ID=
# DISCORD_WEBHOOK_JP=
