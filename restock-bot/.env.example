# 楽天ウェブサービス（https://webservice.rakuten.co.jp/）で取得
RAKUTEN_APPLICATION_ID=
# 楽天アフィリエイトID（通知のリンクがアフィリエイトリンクになります）
RAKUTEN_AFFILIATE_ID=
# APIの仕様変更に備えて上書きできるようにしています
# RAKUTEN_ENDPOINT=https://app.rakuten.co.jp/services/api/IchibaItem/Search/20220601

# Discord の Webhook URL（チャンネルの設定 → 連携サービス → ウェブフック）
# 日本向け（無料・日本語）
DISCORD_WEBHOOK_JP=
# 海外向け（有料ロール限定チャンネル・英語）
DISCORD_WEBHOOK_GLOBAL=

# 海外向けリンクに使う購入代行サービスのURLテンプレート。{url} が商品URLに置き換わります
# 例: PROXY_URL_TEMPLATE=https://example-proxy.com/shop?url={url}
PROXY_URL_TEMPLATE=

# 監視の間隔（秒）
POLL_INTERVAL_SEC=300

# 海外向け通知にドル換算の目安を併記する場合のレート（例: 150）。空なら円のみ
JPY_PER_USD=
